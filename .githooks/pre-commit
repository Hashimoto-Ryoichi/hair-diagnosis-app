#!/bin/sh
# Hair Identity pre-commit: index.html のステージ済み内容にAmazonアフィリチェックをかける。
# チェック本体は .githooks/check-affiliate.sh（フックとdeployスキルで共有する単一の正本）。
# --no-verify で飛ばさないこと。フック・スクリプトの削除/無効化はしない。
if git diff --cached --name-only | grep -q '^index\.html$'; then
  root=$(git rev-parse --show-toplevel)
  tmp=$(mktemp)
  git show :index.html > "$tmp"
  if ! "$root/.githooks/check-affiliate.sh" "$tmp"; then
    rm -f "$tmp"
    echo "✗ pre-commit: Amazonアフィリチェックに失敗。コミットを中止しました。" >&2
    exit 1
  fi
  # Top Pick設計整合チェック（ING_PROFILES登録漏れ・key衝突・top重複・topボーナス改変を検出）
  if ! node "$root/.githooks/check-design.js" "$tmp"; then
    rm -f "$tmp"
    echo "✗ pre-commit: 設計整合チェックに失敗。コミットを中止しました。" >&2
    exit 1
  fi
  rm -f "$tmp"
  # 検査を通ったので、sitemap.xml の lastmod を今日に揃えてコミットに含める。
  # （Amazon審査の「60日以内に更新」基準に対し、更新実態と申告がズレるのを機械で防ぐ）
  if ! "$root/.githooks/sync-sitemap.sh"; then
    echo "✗ pre-commit: sitemapのlastmod同期に失敗。コミットを中止しました。" >&2
    exit 1
  fi
fi
# 参照ドキュメントの腐り検査（廃止IDのベタ書き・index.htmlのコピーを検出）
root=$(git rev-parse --show-toplevel)
if ! "$root/.githooks/check-docs.sh"; then
  echo "✗ pre-commit: ドキュメント検査に失敗。コミットを中止しました。" >&2
  exit 1
fi
exit 0
